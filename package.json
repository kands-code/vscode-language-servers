{
  "name": "@qarks/vscode-language-servers",
  "version": "1.143.1",
  "description": "CSS, HTML, and JSON language servers extracted from microsoft/vscode, installable from GitHub",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kands-code/vscode-language-servers.git"
  },
  "bin": {
    "vscode-css-language-server": "dist/css.cjs",
    "vscode-html-language-server": "dist/html.cjs",
    "vscode-json-language-server": "dist/json.cjs"
  },
  "files": [
    "dist",
    "lib",
    "LICENSE.vscode.txt"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "extract": "node --experimental-strip-types scripts/extract.ts",
    "check": "tsc --noEmit -p scripts/tsconfig.check.json",
    "build": "rolldown -c && node --experimental-strip-types scripts/copy-assets.ts",
    "smoke": "node --experimental-strip-types scripts/smoke-test.ts",
    "format": "oxfmt --check scripts rolldown.config.ts",
    "format:fix": "oxfmt scripts rolldown.config.ts",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix"
  },
  "dependencies": {
    "typescript": "6.0.3"
  },
  "devDependencies": {
    "@types/node": "^24.12.4",
    "oxfmt": "^0.72.0",
    "oxlint": "^1.87.0",
    "rolldown": "^1.0.0"
  }
}
